{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "targetPlayerId"],
      "properties": {
        "action": {
          "const": "vote"
        },
        "targetPlayerId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "const": "abstain"
        }
      }
    }
  ]
}
