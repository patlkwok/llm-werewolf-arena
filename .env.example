# Optional persistent server-side key. Copy to ignored .env.local and set the key there.
# .env.local is plaintext on disk; protect access to your local workspace.
OPENROUTER_API_KEY=

# Local V1 database
DATABASE_URL=file:./data/llm-werewolf.db

# Optional app metadata for OpenRouter, if used
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=LLM Werewolf Arena
